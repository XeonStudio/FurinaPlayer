<UserControl
    x:Class="FurinaPlayer.UI.Controls.MiniPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SonicWave.Core.Models">

    <UserControl.Resources>
        <DataTemplate x:Key="RecentTrackTemplate"                          >
            <Grid ColumnSpacing="10" Padding="6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="14" Padding="16,8,16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Column 0: 曲目封面与信息 -->
                <ColumnDefinition Width="Auto" MinWidth="160" MaxWidth="280" />
                <!-- Column 1: 走带控制与完整进度时间轴 (居中) -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: 辅助操作 (播放模式 + 最近播放) -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：封面与曲目信息 (点击自动跳转正在播放选项卡) -->
            <Grid x:ConnectionId='10' x:Name="TrackInfoPanel" Grid.Column="0" ColumnSpacing="10" VerticalAlignment="Center"
                  Background="Transparent" ToolTipService.ToolTip="点击跳转正在播放"
                  AutomationProperties.Name="迷你-专辑封面与曲目信息">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:ConnectionId='11' x:Name="CoverBorder" Width="44" Height="44" CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Artist}" />
                </StackPanel>
            </Grid>

            <!-- 中间：核心播放控制与进度时间轴 -->
            <Grid Grid.Column="1" RowSpacing="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="620">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 播放走带按钮群 (居中，播放/暂停按钮适当放大至44x44突出核心焦点) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PreviousCommand}"
                            ToolTipService.ToolTip="上一曲" AutomationProperties.Name="迷你-上一曲"
                            Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE892;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PlayCommand}"
                            Visibility="{Binding PlayButtonVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="播放" AutomationProperties.Name="迷你-播放"
                            Width="44" Height="44" Padding="0">
                        <FontIcon Glyph="&#xE768;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PauseCommand}"
                            Visibility="{Binding PauseButtonVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="暂停" AutomationProperties.Name="迷你-暂停"
                            Width="44" Height="44" Padding="0">
                        <FontIcon Glyph="&#xE769;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding NextCommand}"
                            ToolTipService.ToolTip="下一曲" AutomationProperties.Name="迷你-下一曲"
                            Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE893;" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- 进度条与高精度时间显示 -->
                <Grid Grid.Row="1" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:ConnectionId='8' x:Name="PositionText" Grid.Column="0" Text="00:00" FontSize="11" Opacity="0.75"
                               VerticalAlignment="Center" Width="36" TextAlignment="Right" />

                    <Slider x:ConnectionId='7' Grid.Column="1" Minimum="0" Maximum="100"
                            Value="{Binding PositionPercent, Mode=OneWay}"
                            IsThumbToolTipEnabled="False" MinHeight="26" Height="26"
                            VerticalAlignment="Center" Margin="0"
                            AutomationProperties.Name="迷你-播放进度">
                        <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackFill" Color="#2E808080" />
                            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40808080" />
                            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#50808080" />
                        </Slider.Resources>
                    </Slider>

                    <TextBlock x:ConnectionId='9' x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="11" Opacity="0.75"
                               VerticalAlignment="Center" Width="36" TextAlignment="Left" />
                </Grid>
            </Grid>

            <!-- 右侧：辅助操作 (播放模式 + 最近播放) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding CycleModeCommand}"
                        ToolTipService.ToolTip="播放模式" AutomationProperties.Name="迷你-播放模式"
                        Width="Auto" MinWidth="72" Padding="8,0" Height="32">
                    <TextBlock Text="{Binding ModeText}" FontSize="11" />
                </Button>
                <Button x:ConnectionId='4' x:Name="RecentButton" Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="最近播放" AutomationProperties.Name="迷你-最近播放"
                        Width="32" Height="32" Padding="0">
                    <Button.Flyout>
                        <Flyout x:ConnectionId='5' Placement="Top">
                            <StackPanel Width="400" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Text="最近播放" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="显示最近 6 首，滚动查看其余" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView x:ConnectionId='6' x:Name="RecentList" ItemsSource="{Binding RecentTracks}"
                                          ItemTemplate="{StaticResource RecentTrackTemplate}"
                                          SelectionMode="None" IsItemClickEnabled="True"
                                          MaxHeight="372" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE823;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

