<UserControl
    x:Class="FurinaPlayer.UI.Controls.MiniPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SonicWave.Core.Models">

    <UserControl.Resources>
        <DataTemplate x:Key="RecentTrackTemplate"                          >
            <Grid ColumnSpacing="10" Padding="6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="12" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 封面 -->
            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <!-- 标题/进度 -->
            <Grid Grid.Column="1" RowSpacing="4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Slider x:ConnectionId='7' Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding PositionPercent, Mode=OneWay}"
                                                                                                     
                                                                                                                                           
                        IsThumbToolTipEnabled="False" Height="18" Opacity="0.8"
                        AutomationProperties.Name="迷你-播放进度" />
            </Grid>
            <!-- 控制 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PreviousCommand}" ToolTipService.ToolTip="上一曲" AutomationProperties.Name="迷你-上一曲">
                    <FontIcon Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PlayCommand}" Visibility="{Binding PlayButtonVisibility, Mode=OneWay}" ToolTipService.ToolTip="播放" AutomationProperties.Name="迷你-播放">
                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding PauseCommand}" Visibility="{Binding PauseButtonVisibility, Mode=OneWay}" ToolTipService.ToolTip="暂停" AutomationProperties.Name="迷你-暂停">
                    <FontIcon Glyph="&#xE769;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding NextCommand}" ToolTipService.ToolTip="下一曲" AutomationProperties.Name="迷你-下一曲">
                    <FontIcon Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Command="{Binding CycleModeCommand}" ToolTipService.ToolTip="播放模式" AutomationProperties.Name="迷你-播放模式"
                        Width="Auto" MinWidth="72" Padding="10,0">
                    <TextBlock Text="{Binding ModeText}" FontSize="11" />
                </Button>
                <Button x:ConnectionId='4' x:Name="RecentButton" Style="{StaticResource TransportButtonStyle}"
                        ToolTipService.ToolTip="最近播放" AutomationProperties.Name="迷你-最近播放">
                    <Button.Flyout>
                        <Flyout x:ConnectionId='5' Placement="Top"                                >
                            <StackPanel Width="400" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Text="最近播放" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="显示最近 6 首，滚动查看其余" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView x:ConnectionId='6' x:Name="RecentList" ItemsSource="{Binding RecentTracks}"
                                          ItemTemplate="{StaticResource RecentTrackTemplate}"
                                          SelectionMode="None" IsItemClickEnabled="True"                              
                                          MaxHeight="372" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE823;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

