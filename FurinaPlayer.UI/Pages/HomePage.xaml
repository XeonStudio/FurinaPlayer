<Page x:ConnectionId='1'
    x:Class="FurinaPlayer.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SonicWave.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FurinaPlayer.UI.Pages"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 全部歌曲-专辑列宽度（拖动对齐条调整，运行时可更新） -->
        <!-- AlbumColWidth removed for experiment -->
    </Page.Resources>

    <Grid x:ConnectionId='2' x:Name="PageRoot" RowSpacing="12" Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 搜索 + 操作 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Furina player" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:ConnectionId='18' Grid.Column="1" PlaceholderText="搜索歌曲 / 专辑 / 艺术家" Text="{Binding SearchText, Mode=TwoWay}"
                                               VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left" Width="360" />
            <Button x:ConnectionId='19' Grid.Column="2"                           Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="扫描文件夹" />
                </StackPanel>
            </Button>
            <Button x:ConnectionId='20' Grid.Column="3"                           >
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock Text="打开文件" />
                </StackPanel>
            </Button>
            <ProgressRing Grid.Column="4" IsActive="{Binding IsScanning, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Center" />
        </Grid>

        <!-- 主体：专辑（4x2 大图 / 2x4 列表）+ 全部歌曲 -->
        <Grid Grid.Row="1" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 专辑区 -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE786;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                    <TextBlock Text="专辑" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="点击专辑可筛选歌曲" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <Button x:ConnectionId='17'                                Padding="8,4" ToolTipService.ToolTip="切换大图/列表模式" AutomationProperties.Name="切换专辑视图">
                        <Grid Width="16" Height="16">
                            <FontIcon Glyph="&#xE71D;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding AlbumGridViewVisibility}" />
                            <FontIcon Glyph="&#xE8A7;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding AlbumListViewVisibility}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 大图卡片模式：6 列一行，滚动条浏览其余 -->
                <ScrollViewer Height="500" VerticalScrollBarVisibility="Auto" Visibility="{Binding AlbumGridViewVisibility}">
                    <GridView x:ConnectionId='14' ItemsSource="{Binding Albums}" SelectionMode="None" IsItemClickEnabled="True"                         
                                                              
                              Padding="0,0,0,8">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,16,18" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate                          >
                                <StackPanel Width="150" Spacing="6">
                                    <Border Width="150" Height="150" CornerRadius="16"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE786;" FontSize="52" Foreground="White" Opacity="0.85"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>

                <!-- 列表模式：2 列 x 4 行，靠左对齐，滚动条浏览其余 -->
                <ScrollViewer Height="316" VerticalScrollBarVisibility="Auto" Visibility="{Binding AlbumListViewVisibility}">
                    <GridView x:ConnectionId='11' ItemsSource="{Binding Albums}" SelectionMode="None" IsItemClickEnabled="True"                         
                              HorizontalAlignment="Left" Padding="0,0,0,8">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,28,18" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate                          >
                                <StackPanel Orientation="Horizontal" Spacing="12" Width="320">
                                    <Border Width="64" Height="64" CornerRadius="14"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE786;" FontSize="26" Foreground="White" Opacity="0.85"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </StackPanel>

            <!-- 全部歌曲区（与专辑区加大间隔） -->
            <Grid Grid.Row="1" RowSpacing="6" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="全部歌曲" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="{Binding AlbumFilterVisibility, Mode=OneWay}">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="10,3">
                        <TextBlock Text="{Binding AlbumFilterText, Mode=OneWay}" FontSize="12" Foreground="White" />
                    </Border>
                    <HyperlinkButton x:ConnectionId='10' Content="清除筛选"                            FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 列表表头：专辑列宽度可由“对齐条”拖动调整（对齐条 = 歌名列与专辑列之间的竖线） -->
                <Grid x:ConnectionId='3' x:Name="HeaderGrid" ColumnSpacing="10" Padding="4,0" Opacity="0.75">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition x:ConnectionId='8'                                                  />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="封面" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="#" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="歌名 / 歌手" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <Grid x:ConnectionId='9' Grid.Column="3" Background="Transparent"
                                                                                                         
                                                                                                                    
                          ToolTipService.ToolTip="拖动调整歌名与专辑的间隔" AutomationProperties.Name="歌名专辑间隔对齐条">
                        <Border Width="2" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="1" />
                    </Grid>
                    <TextBlock Grid.Column="4" Text="专辑" FontSize="11" Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="5" Text="格式" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="时长" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                </Grid>
                <ListView x:ConnectionId='4' x:Name="TracksList" Grid.Row="1" ItemsSource="{Binding VisibleTracks}" SelectionMode="Single" IsItemClickEnabled="True"
                                                  
                          CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                                                                                    
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='6' ColumnSpacing="10" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition x:ConnectionId='7'                                                  />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding CoverPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding TrackNumber}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding Album}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Format}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding DurationText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>

