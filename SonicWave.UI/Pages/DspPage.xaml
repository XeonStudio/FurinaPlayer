<Page x:ConnectionId='1'
    x:Class="SonicWave.UI.Pages.DspPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SonicWave.UI.Controls"
    xmlns:models="using:SonicWave.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="效果器与DSP设置" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="图形化调节，实时作用于播放；拖动标题移动面板，拖动右下角缩放，设置自动保存"
                       Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
            <Button x:ConnectionId='38'                            Padding="8,4" ToolTipService.ToolTip="恢复面板默认位置与大小">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="重置布局" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 自由画布：均衡器 / 效果器 / 音色，默认居中，可拖拽、缩放，布局记忆 -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:ConnectionId='6' x:Name="PanelCanvas" Width="1560" Height="760" Background="Transparent">

                <!-- 图形化均衡器 -->
                <Border x:ConnectionId='7' x:Name="EqPanel" Canvas.Left="20" Canvas.Top="16" Width="660" Height="460" CornerRadius="12" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:ConnectionId='31' x:Name="EqHeader" ColumnSpacing="6" Background="Transparent"
                              ToolTipService.ToolTip="拖动标题移动面板，点右上角编辑按钮或拖右下角调整大小">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE995;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="图形化均衡器" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            <Button x:ConnectionId='37' Grid.Column="2" Tag="Eq"                          Padding="4,2" ToolTipService.ToolTip="调整面板大小">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="8">
                                        <Canvas x:ConnectionId='36' x:Name="EqCurveCanvas" Height="140"                                     />
                                    </Border>
                                    <controls:EqualizerControl x:ConnectionId='33' x:Name="DspEq"                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:ConnectionId='34' x:Name="EqPresetCombo"                                      MinWidth="150">
                                            <ComboBoxItem Content="平坦" /><ComboBoxItem Content="流行" /><ComboBoxItem Content="摇滚" />
                                            <ComboBoxItem Content="爵士" /><ComboBoxItem Content="古典" /><ComboBoxItem Content="电子" />
                                            <ComboBoxItem Content="乡村" /><ComboBoxItem Content="低音增强" /><ComboBoxItem Content="高音增强" />
                                        </ComboBox>
                                        <TextBlock Text="{Binding EqPresetName, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                                        <Button x:ConnectionId='35' Content="重置全部"                      />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- 右下角缩放柄 -->
                            <Grid x:ConnectionId='32' x:Name="EqResizeHandle" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Background="Transparent" ToolTipService.ToolTip="拖拽调整大小">
                                <Path Data="M0,20 L20,0 L20,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 效果器 -->
                <Border x:ConnectionId='8' x:Name="EffectsPanel" Canvas.Left="700" Canvas.Top="16" Width="640" Height="400" CornerRadius="12" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:ConnectionId='27' x:Name="EffectsHeader" ColumnSpacing="6" Background="Transparent"
                              ToolTipService.ToolTip="拖动标题移动面板，点右上角编辑按钮或拖右下角调整大小">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE950;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="效果器" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            <Button x:ConnectionId='30' Grid.Column="2" Tag="Effects"                          Padding="4,2" ToolTipService.ToolTip="调整面板大小">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch Header="空间音频" IsOn="{Binding ReverbEnabled, Mode=TwoWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <ComboBox x:ConnectionId='29' x:Name="ReverbPresetCombo" Header="空间类型" SelectedIndex="1" MinWidth="150"                                         >
                                            <ComboBoxItem Content="大厅" /><ComboBoxItem Content="板式" /><ComboBoxItem Content="房间" />
                                            <ComboBoxItem Content="教堂" /><ComboBoxItem Content="空间" />
                                        </ComboBox>
                                        <Slider Header="空间混合" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding ReverbMix, Mode=TwoWay}" Width="360" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Slider Header="立体声宽度" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding SpatialWidth, Mode=TwoWay}" Width="220" />
                                        <Slider Header="空间调制" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{Binding SpatialModulation, Mode=TwoWay}" Width="220" />
                                    </StackPanel>
                                    <Slider Header="预延时（毫秒）" Minimum="0" Maximum="120" StepFrequency="1" Value="{Binding SpatialPredelayMs, Mode=TwoWay}" Width="460" />
                                    <Slider Header="播放速度" Minimum="0.5" Maximum="2.0" StepFrequency="0.05" Value="{Binding Speed, Mode=TwoWay}" Width="460" />
                                    <TextBlock Text="空间音频：多频段去相关混响 + 慢速调制 + 立体声宽度，替代旧混响；与音色使用预渲染链路，开启后播放前先整曲渲染再播放。"
                                               TextWrapping="Wrap" Opacity="0.6" FontSize="11" />
                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid x:ConnectionId='28' x:Name="EffectsResizeHandle" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Background="Transparent" ToolTipService.ToolTip="拖拽调整大小">
                                <Path Data="M0,20 L20,0 L20,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 音色（仿海贝 MSEB 感知调节） -->
                <Border x:ConnectionId='9' x:Name="TimbrePanel" Canvas.Left="700" Canvas.Top="432" Width="640" Height="320" CornerRadius="12" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:ConnectionId='24' x:Name="TimbreHeader" ColumnSpacing="6" Background="Transparent"
                              ToolTipService.ToolTip="拖动标题移动面板，点右上角编辑按钮或拖右下角调整大小">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="音色（MSEB 风格）" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                            <Button x:ConnectionId='26' Grid.Column="2" Tag="Timbre"                          Padding="4,2" ToolTipService.ToolTip="调整面板大小">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider Grid.Column="0" Header="低音" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreBass, Mode=TwoWay}" />
                            <Slider Grid.Column="1" Header="中音" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreMidrange, Mode=TwoWay}" />
                            <Slider Grid.Column="2" Header="高音" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreTreble, Mode=TwoWay}" />
                            <Slider Grid.Row="1" Grid.Column="0" Header="声音厚度" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreThickness, Mode=TwoWay}" />
                            <Slider Grid.Row="1" Grid.Column="1" Header="清透度" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreClarity, Mode=TwoWay}" />
                            <Slider Grid.Row="1" Grid.Column="2" Header="声场（宽度）" Minimum="-10" Maximum="10" StepFrequency="1" Value="{Binding TimbreSoundstage, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="参考海贝 MSEB 音色方案：低音/中音/高音调节三段主音色，厚度与清透度塑造质感，声场控制立体声宽度。范围 -10 ~ +10，0 为中性。"
                                   TextWrapping="Wrap" Opacity="0.55" FontSize="11" />
                        <Grid x:ConnectionId='25' x:Name="TimbreResizeHandle" Grid.Row="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Background="Transparent" ToolTipService.ToolTip="拖拽调整大小">
                            <Path Data="M0,20 L20,0 L20,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- VST3 音频插件管理器（模拟宿主，类似 Audition 增效工具管理器） -->
                <Border x:ConnectionId='10' x:Name="Vst3Panel" Canvas.Left="20" Canvas.Top="492" Width="1320" Height="252" CornerRadius="12" Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:ConnectionId='11' x:Name="Vst3Header" ColumnSpacing="6" Background="Transparent"
                              ToolTipService.ToolTip="拖动标题移动面板，点右上角编辑按钮或拖右下角调整大小">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="VST3 插件管理器" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="扫描系统 VST3 目录并启用插件；点击“界面”打开插件自身可控客户界面，实时独占渲染与播放当前歌曲"
                                           FontSize="10" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:ConnectionId='23' Grid.Column="2" Tag="Vst3"                          Padding="4,2" ToolTipService.ToolTip="调整面板大小">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="扫描目录（可添加本地文件夹）" FontSize="12" Opacity="0.7" />
                                <ListView x:ConnectionId='19' x:Name="Vst3FoldersList" ItemsSource="{Binding Vst3Folders}" SelectionMode="Single" MaxHeight="108"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:ConnectionId='20'                              Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="12" /><TextBlock Text="添加目录" FontSize="12" /></StackPanel>
                                    </Button>
                                    <Button x:ConnectionId='21'                                 Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="12" /><TextBlock Text="移除" FontSize="12" /></StackPanel>
                                    </Button>
                                    <Button x:ConnectionId='22'                         Style="{StaticResource AccentButtonStyle}" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE721;" FontSize="12" /><TextBlock Text="扫描" FontSize="12" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Grid Grid.Column="1" RowSpacing="4">
                                <TextBlock Text="已发现插件（点击“界面”打开插件原生界面并实时独占渲染与播放当前歌曲）" FontSize="12" Opacity="0.7" />
                                <ListView x:ConnectionId='13' x:Name="Vst3PluginsList" ItemsSource="{Binding Vst3Plugins}" SelectionMode="None" MaxHeight="140"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate                                    >
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Vendor}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="·" FontSize="10" Opacity="0.6" />
                                                        <TextBlock Text="{Binding Version}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <ToggleSwitch x:ConnectionId='16' Grid.Column="1" IsOn="{Binding Enabled, Mode=TwoWay}"                        
                                                              MinWidth="64" FontSize="11" Margin="6,0,0,0" />
                                                <ToggleButton x:ConnectionId='17' Grid.Column="2" IsChecked="{Binding Bypass, Mode=TwoWay}"                      
                                                              Padding="10,4" MinWidth="58" Margin="4,0,0,0" ToolTipService.ToolTip="旁通（临时关闭处理）">
                                                    <TextBlock Text="旁通" FontSize="11" />
                                                </ToggleButton>
                                                <Button x:ConnectionId='18' Grid.Column="3" Tag="{Binding}"                           Padding="10,4" MinWidth="58" Margin="4,0,0,0">
                                                    <TextBlock Text="界面" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding Vst3StatusText, Mode=OneWay}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                        <Grid x:ConnectionId='12' x:Name="Vst3ResizeHandle" Grid.Row="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Background="Transparent" ToolTipService.ToolTip="拖拽调整大小">
                            <Path Data="M0,20 L20,0 L20,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.45" />
                        </Grid>
                    </Grid>
                </Border>
            </Canvas>
        </ScrollViewer>

        <!-- 页面下方：效果预渲染进程与剩余时间进度条（渲染完成自动关闭；不再使用正在播放页的提示弹窗） -->
        <Border x:ConnectionId='2' Grid.Row="2" Margin="0,8,0,0" CornerRadius="10" Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                        >
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE895;" FontSize="15" Opacity="0.8" VerticalAlignment="Center" />
                <ProgressBar x:ConnectionId='3'                                                             Minimum="0" Maximum="1"
                             Width="320" Height="14" VerticalAlignment="Center" IsIndeterminate="False" />
                <TextBlock x:ConnectionId='4'                                                         FontSize="12"
                           VerticalAlignment="Center" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                <TextBlock x:ConnectionId='5' x:Name="RenderRemainingText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="渲染完成后自动关闭" />
            </StackPanel>
        </Border>
    </Grid>
</Page>


