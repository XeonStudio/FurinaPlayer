<UserControl
    x:Class="SonicWave.UI.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:ConnectionId='2' x:Name="SourceText" FontSize="11" Opacity="0.6" Margin="4,0,0,2" Text="歌词" />
        <ListView x:ConnectionId='3' x:Name="LyricList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" LineHeight="30"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

