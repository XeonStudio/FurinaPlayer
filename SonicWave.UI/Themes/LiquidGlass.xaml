<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         液态玻璃（Liquid Glass）全局资源
         参考 rdev/liquid-glass-react（Apple Liquid Glass）与 iOS 26 界面：
         半透明磨砂 + 顶部高光 + 边缘高亮描边 + 悬停/按下反馈。
         仅替换视觉，控件大小/间隔/位置不变。
         ============================================================ -->

    <ResourceDictionary.ThemeDictionaries>
        <!-- 浅色 -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlassFillBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="GlassStrokeHoverBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassHighlightBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="GlassTrackBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="GlassThumbBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#CCFFFFFF" />
        </ResourceDictionary>
        <!-- 深色 -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlassFillBrush" Color="#66000000" />
            <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#7A000000" />
            <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="GlassStrokeHoverBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassHighlightBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="GlassTrackBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="GlassThumbBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#52000000" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#40000000" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#33000000" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#52000000" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#59000000" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#B3FFFFFF" />
        </ResourceDictionary>
        <!-- 跟随系统 -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GlassFillBrush" Color="#66000000" />
            <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#7A000000" />
            <SolidColorBrush x:Key="GlassFillPressedBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="GlassStrokeBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="GlassStrokeHoverBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassHighlightBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="GlassTrackBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="GlassThumbBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#52000000" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#40000000" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#33000000" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#52000000" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#66000000" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#59000000" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#B3FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                        <Setter Target="GlassBorder.BorderBrush" Value="{ThemeResource GlassStrokeHoverBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.15" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="GlassBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassFill" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        </Border>
                        <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="6,1,6,0"
                                Background="{ThemeResource GlassHighlightBrush}" Opacity="0.35"
                                CornerRadius="2" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                        <Setter Target="GlassBorder.BorderBrush" Value="{ThemeResource GlassStrokeHoverBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.15" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="GlassFill.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        <Setter Target="Highlight.Opacity" Value="0.2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="GlassBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassFill" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        </Border>
                        <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="6,1,6,0"
                                Background="{ThemeResource GlassHighlightBrush}" Opacity="0.35"
                                CornerRadius="2" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BG.Background" Value="{ThemeResource GlassFillHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="BG.Background" Value="{ThemeResource GlassFillPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="BG.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Setter Target="BG.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="BG.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="BG.Opacity" Value="0.9" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="BG" Background="{ThemeResource GlassFillBrush}"
                                BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.5" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

